{
  "name": "excel-graph-safe-edit",
  "version": "0.1.0",
  "description": "Safe, agent-friendly Microsoft Graph Excel workbook editing.",
  "type": "module",
  "bin": {
    "excel-graph-safe-edit": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "excel",
    "microsoft-graph",
    "onedrive",
    "sharepoint",
    "mcp",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.0",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
